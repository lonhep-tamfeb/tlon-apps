{"name":"Tlon","short_name":"Tlon","start_url":"/apps/groups","display":"standalone","background_color":"#ffffff","lang":"en","scope":"/apps/groups","description":"Start, host, and cultivate communities. Own your communications, organize your resources, and share documents. Tlon is a peer-to-peer collaboration tool built on Urbit that provides a few simple basics that communities can shape into something unique to their needs.","id":"/apps/groups/","icons":[{"src":"./icon-512.png","sizes":"512x512","type":"image/png"},{"src":"./icon-192.png","sizes":"192x192","type":"image/png"},{"src":"./icon-512-maskable.png","sizes":"512x512","type":"image/png","purpose":"maskable"},{"src":"./icon-192-maskable.png","sizes":"192x192","type":"image/png","purpose":"maskable"}],"theme_color":"#ffffff"}
